
#include <stdio.h>
#include <string.h>

#define MAX 50

int id[MAX], available[MAX];
float price[MAX];

char name[MAX][50];
char author[MAX][50];
char category[MAX][30];

int count = 0;

void clearInput()
{
    int ch;
    while ((ch = getchar()) != '\n' && ch != EOF);
}

int findBook(int bookId)
{
    int i;

    for(i = 0; i < count; i++)
    {
        if(id[i] == bookId)
            return i;
    }

    return -1;
}

void addBook()
{
    int bookId;

    if(count >= MAX)
    {
        printf("Library is full!\n");
        return;
    }

    printf("Enter Book ID: ");
    if(scanf("%d", &bookId) != 1)
    {
        printf("Invalid ID!\n");
        clearInput();
        return;
    }
    clearInput();

    if(findBook(bookId) != -1)
    {
        printf("Book ID already exists!\n");
        return;
    }

    id[count] = bookId;

    printf("Enter Book Name: ");
    scanf(" %49[^\n]", name[count]);

    printf("Enter Author Name: ");
    scanf(" %49[^\n]", author[count]);

    printf("Enter Category: ");
    scanf(" %29[^\n]", category[count]);

    printf("Enter Price: ");
    if(scanf("%f", &price[count]) != 1 || price[count] < 0)
    {
        printf("Invalid price!\n");
        clearInput();
        return;
    }
    clearInput();

    available[count] = 1;

    count++;

    printf("Book added successfully!\n");
}

void displayBooks()
{
    int i;

    if(count == 0)
    {
        printf("No books available!\n");
        return;
    }

    for(i = 0; i < count; i++)
    {
        printf("\nBook ID: %d\n", id[i]);
        printf("Book Name: %s\n", name[i]);
        printf("Author: %s\n", author[i]);
        printf("Category: %s\n", category[i]);
        printf("Price: %.2f\n", price[i]);

        if(available[i] == 1)
            printf("Status: Available\n");
        else
            printf("Status: Issued\n");
    }
}

void searchById()
{
    int bookId, i;

    printf("Enter Book ID: ");
    if(scanf("%d", &bookId) != 1)
    {
        printf("Invalid ID!\n");
        clearInput();
        return;
    }
    clearInput();

    i = findBook(bookId);

    if(i == -1)
    {
        printf("Book not found!\n");
    }
    else
    {
        printf("\nBook Name: %s\n", name[i]);
        printf("Author: %s\n", author[i]);
        printf("Category: %s\n", category[i]);
        printf("Price: %.2f\n", price[i]);

        if(available[i] == 1)
            printf("Status: Available\n");
        else
            printf("Status: Issued\n");
    }
}

void searchByName()
{
    char search[50];
    int i, found = 0;

    printf("Enter Book Name: ");
    scanf(" %49[^\n]", search);

    for(i = 0; i < count; i++)
    {
        if(strstr(name[i], search) != NULL)
        {
            printf("\nBook ID: %d\n", id[i]);
            printf("Book Name: %s\n", name[i]);
            printf("Author: %s\n", author[i]);
            printf("Category: %s\n", category[i]);

            found = 1;
        }
    }

    if(found == 0)
        printf("Book not found!\n");
}

void issueBook()
{
    int bookId, i;
    static int issueCount = 0;

    printf("Enter Book ID to issue: ");
    if(scanf("%d", &bookId) != 1)
    {
        printf("Invalid ID!\n");
        clearInput();
        return;
    }
    clearInput();

    i = findBook(bookId);

    if(i == -1)
    {
        printf("Book not found!\n");
    }
    else if(available[i] == 0)
    {
        printf("Book is already issued!\n");
    }
    else
    {
        available[i] = 0;
        issueCount++;

        printf("Book issued successfully!\n");
        printf("Total issue operations: %d\n", issueCount);
    }
}

void returnBook()
{
    int bookId, i;

    printf("Enter Book ID to return: ");
    if(scanf("%d", &bookId) != 1)
    {
        printf("Invalid ID!\n");
        clearInput();
        return;
    }
    clearInput();

    i = findBook(bookId);

    if(i == -1)
    {
        printf("Book not found!\n");
    }
    else if(available[i] == 1)
    {
        printf("Book is already available!\n");
    }
    else
    {
        available[i] = 1;
        printf("Book returned successfully!\n");
    }
}

void updateBook()
{
    int bookId, i;

    printf("Enter Book ID to update: ");
    if(scanf("%d", &bookId) != 1)
    {
        printf("Invalid ID!\n");
        clearInput();
        return;
    }
    clearInput();

    i = findBook(bookId);

    if(i == -1)
    {
        printf("Book not found!\n");
        return;
    }

    printf("Enter New Book Name: ");
    scanf(" %49[^\n]", name[i]);

    printf("Enter New Author Name: ");
    scanf(" %49[^\n]", author[i]);

    printf("Enter New Category: ");
    scanf(" %29[^\n]", category[i]);

    printf("Enter New Price: ");
    if(scanf("%f", &price[i]) != 1 || price[i] < 0)
    {
        printf("Invalid price!\n");
        clearInput();
        return;
    }
    clearInput();

    printf("Book details updated successfully!\n");
}

void countBooks()
{
    printf("Total Books: %d\n", count);
}

void displayAvailable()
{
    int i, found = 0;

    for(i = 0; i < count; i++)
    {
        if(available[i] == 1)
        {
            printf("\nBook ID: %d\n", id[i]);
            printf("Book Name: %s\n", name[i]);
            printf("Author: %s\n", author[i]);
            printf("Category: %s\n", category[i]);

            found = 1;
        }
    }

    if(found == 0)
        printf("No available books!\n");
}

int main()
{
    int choice;

    do
    {
        printf("\n===== LIBRARY MANAGEMENT SYSTEM =====\n");
        printf("1. Add New Book\n");
        printf("2. Display All Books\n");
        printf("3. Search Book by ID\n");
        printf("4. Search Book by Name\n");
        printf("5. Issue Book\n");
        printf("6. Return Book\n");
        printf("7. Update Book Details\n");
        printf("8. Count Total Books\n");
        printf("9. Display Available Books\n");
        printf("10. Exit\n");

        printf("Enter your choice: ");

        if(scanf("%d", &choice) != 1)
        {
            printf("Invalid choice!\n");
            clearInput();
            continue;
        }
        clearInput();

        switch(choice)
        {
            case 1:
                addBook();
                break;

            case 2:
                displayBooks();
                break;

            case 3:
                searchById();
                break;

            case 4:
                searchByName();
                break;

            case 5:
                issueBook();
                break;

            case 6:
                returnBook();
                break;

            case 7:
                updateBook();
                break;

            case 8:
                countBooks();
                break;

            case 9:
                displayAvailable();
                break;

            case 10:
                printf("Thank you! Program ended.\n");
                break;

            default:
                printf("Invalid choice! Try again.\n");
        }

    } while(choice != 10);

    return 0;
}
